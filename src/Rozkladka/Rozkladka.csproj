<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Rozkladka</AssemblyName>
    <RootNamespace>Rozkladka</RootNamespace>
    <ApplicationIcon>rozkladka.ico</ApplicationIcon>
    <Product>Rozkladka</Product>
    <Description>Автоматичне перемикання розкладки клавіатури</Description>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rozkladka.Core\Rozkladka.Core.csproj" />
  </ItemGroup>
</Project>
